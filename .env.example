# --- keys (real mode) ---------------------------------------------------
ANTHROPIC_API_KEY=
INTENTLIST_BRAVE_API_KEY=
INTENTLIST_ZEROBOUNCE_API_KEY=
# INTENTLIST_MILLIONVERIFIER_API_KEY=

# --- providers ----------------------------------------------------------
# search: brave|fixture   extractor: claude|rules   planner: claude|template
# email_verifier: zerobounce|millionverifier|local|fixture
INTENTLIST_SEARCH_PROVIDER=brave
INTENTLIST_EXTRACTOR=claude
INTENTLIST_PLANNER=claude
INTENTLIST_EMAIL_VERIFIER=zerobounce
INTENTLIST_ANTHROPIC_MODEL=claude-sonnet-5

# --- storage ------------------------------------------------------------
# Outside Docker: INTENTLIST_DATABASE_URL=postgresql+psycopg://intentlist:change-me@localhost:5432/intentlist
INTENTLIST_CAPTURE_DIR=/app/data/captures
INTENTLIST_EXPORT_DIR=/app/data/exports
POSTGRES_PASSWORD=change-me

# --- crawling etiquette: identify the bot honestly ------------------------
INTENTLIST_USER_AGENT=YourCompanyResearchBot/1.0 (+https://yourcompany.example/bot; ops@yourcompany.example)
INTENTLIST_DEFAULT_RATE_LIMIT_RPS=0.5

# --- policy -------------------------------------------------------------
INTENTLIST_BATCH_SIZE=100
INTENTLIST_MAX_POST_AGE_DAYS=730
INTENTLIST_QUERIES_PER_RUN=40
INTENTLIST_MIN_CONFIDENCE=0.6
INTENTLIST_SCHEDULE_CRON=0 2 * * MON

# --- cost model for per-record reporting (USD; set to your contracted rates) ---
INTENTLIST_COST_SEARCH_CALL=0.005
INTENTLIST_COST_LLM_INPUT_MTOK=3.0
INTENTLIST_COST_LLM_OUTPUT_MTOK=15.0
INTENTLIST_COST_EMAIL_VERIFICATION=0.008

# --- review console logins: user:password,user2:password2 ----------------
INTENTLIST_REVIEWERS=reviewer1:change-me-now
